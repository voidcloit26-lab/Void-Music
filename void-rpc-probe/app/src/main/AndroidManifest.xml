<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
  <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:node="remove" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
  <queries>
    <package android:name="com.discord" />
    <package android:name="online.voidbot.music.fast" />
    <package android:name="online.voidbot.music" />
    <package android:name="online.voidbot.music.debug" />
  </queries>
  <application android:label="VOID RPC Probe" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
    <activity android:name="com.discord.socialsdk.AuthenticationActivity" tools:node="remove" />
    <service android:name="com.discord.socialsdk.ForegroundService" tools:node="remove" />
    <service android:name=".PresenceService" android:exported="false" android:foregroundServiceType="specialUse" android:stopWithTask="true">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled Discord music activity sharing with a persistent stop notification" />
    </service>
    <activity android:name=".ProbeActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
    </activity>
  </application>
</manifest>
